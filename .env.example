# Copy this file to .env and fill in your values (never upload .env to GitHub)
GROQ_API_KEY=gsk_paste-your-key-here
# Password for the conversations page (/admin). Username can be anything.
ADMIN_PASSWORD=choose-a-strong-password
# Your domain, already pointing to this server's IP (only needed on a server)
DOMAIN=assistant.example.com
# Optional: n8n webhook that saves questions the bot could not answer
N8N_UNANSWERED_URL=https://your-n8n-domain/webhook/your-path
